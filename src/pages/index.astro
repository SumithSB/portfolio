  <script>
    // Copy email: shown only when the clipboard API exists.
    const btn = document.getElementById('copy-email');
    const status = document.getElementById('copy-status');
    if (btn && status && navigator.clipboard) {
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('sumithsbhandari@gmail.com');
          status.textContent = 'Copied';
        } catch {
          status.textContent = 'Copy failed. Select the address instead.';
        }
        setTimeout(() => { status.textContent = ''; }, 2500);
      });
    }

    // Demo video: play muted while in view, unless the visitor prefers reduced motion.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const videos = document.querySelectorAll<HTMLVideoElement>('video.autoplay');
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      }, { threshold: 0.5 });
      videos.forEach((v) => io.observe(v));
    }
  </script>
