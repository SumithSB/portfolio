---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import Trace from '../components/Trace.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = (file: string) => `${base}/media/${file}`;
const year = new Date().getFullYear();

// CV links appear only once public/Sumith_Bhandari_CV.pdf exists.
const cvFile = 'Sumith_Bhandari_CV.pdf';
const hasCv = fs.existsSync(new URL(`../../public/${cvFile}`, import.meta.url));
const cvHref = `${base}/${cvFile}`;

const email = 'sumithsbhandari@gmail.com';
const links = {
  github: 'https://github.com/SumithSB',
  linkedin: 'https://linkedin.com/in/sumith-sadanand-bhandari',
  x: 'https://x.com/SumithSBhandari',
};

const skills = [
  ['AI and agents', ['Anthropic and OpenAI APIs', 'multi-agent orchestration (Strands on AWS)', 'tool-calling agents', 'MCP', 'RAG', 'embeddings', 'hybrid search (dense and BM25)', 'prompt caching', 'human-review steps', 'retrieval evaluation (MRR, Precision@k)', 'LangChain', 'Ollama']],
  ['Backend', ['Python', 'TypeScript', 'Node.js', 'FastAPI', 'Flask', 'Express.js', 'REST APIs', 'webhooks', 'WebSockets', 'async APIs', 'job queues and concurrent workers']],
  ['Data', ['PostgreSQL', 'pgvector', 'SQLite (FTS5, sqlite-vec)', 'Supabase', 'MongoDB', 'MySQL', 'Redis']],
  ['Cloud and delivery', ['AWS (EC2, S3, Lambda, IAM, CloudWatch, VPC)', 'GCP', 'Docker', 'NGINX', 'GitHub Actions', 'Jenkins', 'Railway', 'Vercel']],
  ['Quality and security', ['Pytest', 'unit and integration testing', 'production-readiness reviews', 'rollback drills', 'Row Level Security', 'role-based access', 'audit trails', 'OWASP Top 10', 'GDPR, PECR and EU AI Act reviews']],
  ['Also', ['Swift', 'Rust (Tauri)', 'Dart (Flutter)', 'Claude Code', 'Cursor']],
] as const;
---
<Base
  title="Sumith Bhandari | AI Software Engineer, London"
  description="AI Software Engineer in London. 4+ years building production backend and AI agent systems in Python and TypeScript. Creator of Claude Anchor and Brainvault."
>
  <a class="skip" href="#main">Skip to main content</a>

  <div id="plot" aria-hidden="true">
    <svg viewBox="0 0 720 360">
      <path class="p" d="M40 180 H170" />
      <path class="p" d="M170 60 V300" />
      <path class="p" d="M170 60 H300 M170 140 H300 M170 220 H300 M170 300 H300" />
      <path class="p" d="M300 40 h150 v40 h-150 z M300 120 h150 v40 h-150 z M300 200 h150 v40 h-150 z M300 280 h150 v40 h-150 z" />
      <path class="p" d="M450 60 H540 M450 140 H540 M450 220 H540 M450 300 H540 M540 60 V300" />
      <path class="p r" d="M540 180 H600 M600 120 h80 v120 h-80 z" />
    </svg>
  </div>

  <header class="site-header wrap">
