        </div>
        <div class="flow-stage" id="flow-stage" aria-hidden="true">
          <div class="rig" id="rig">
            <div class="layer" data-depth="0">
              <div class="flow">
                <div class="bar"><b>Claude Anchor</b><span>Folder routing</span><span class="pill"><i></i>Demo</span></div>
                <div class="grid"></div>
                <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none">
                  <path d="M28 52 C33 52 32 30 38 30" /><path d="M28 52 C33 52 32 74 38 74" />
                  <path d="M59 30 C65 30 64 52 70 52" /><path d="M59 74 C65 74 64 52 70 52" />
                  <path class="pulse" pathLength="100" d="M28 52 C33 52 32 30 38 30" /><path class="pulse b" pathLength="100" d="M28 52 C33 52 32 74 38 74" />
                  <path class="pulse" pathLength="100" d="M59 30 C65 30 64 52 70 52" /><path class="pulse b" pathLength="100" d="M59 74 C65 74 64 52 70 52" />
                </svg>
                <span class="wlabel" style="left:30%; top:30%">match</span>
                <span class="wlabel" style="left:30%; top:76%">else</span>
                <div class="fbase" style="left:7%; top:55%"></div>
                <div class="fbase" style="left:38%; top:36%"></div>
                <div class="fbase" style="left:38%; top:76%"></div>
                <div class="fbase" style="left:70%; top:55%"></div>
                <div class="fnode" style="left:7%; top:55%"><b>Folder opened</b><span>terminal, VS Code or Cursor</span></div>
