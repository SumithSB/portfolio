---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import { chapters } from '../data/story';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const m = (file: string) => `${base}/media/${file}`;
const year = new Date().getFullYear();

// CV links appear only once public/Sumith_Bhandari_CV.pdf exists.
const cvFile = 'Sumith_Bhandari_CV.pdf';
const hasCv = fs.existsSync(new URL(`../../public/${cvFile}`, import.meta.url));
const cvHref = `${base}/${cvFile}`;

const email = 'sumithsbhandari@gmail.com';
const links = {
  github: 'https://github.com/SumithSB',
  linkedin: 'https://linkedin.com/in/sumith-sadanand-bhandari',
  x: 'https://x.com/SumithSBhandari',
};

// Named, minimal: where, what, when. Oldest first, so it ends where the walk ends.
const journey = [
  { when: 'Aug 2018 to Jul 2022', place: 'Bengaluru', org: 'Ramaiah Institute of Technology', roles: ['BE Information Science'], note: 'Where I started out feeling behind, and started building anyway.' },
  { when: 'Nov 2020 to May 2022', place: 'Bengaluru', org: 'Drogher Technologies', roles: ['Co-Founder and Engineering Lead'], note: 'The company that came out of our lockdown app. Led the engineering until we closed it.' },
  { when: 'Nov 2021 to Dec 2024', place: 'Bengaluru', org: 'TechMachinery Labs', roles: ['Software Engineer', 'Software Development Engineer', 'SDE 1, part-time'], note: 'Joined as an intern, stayed for three years. Grew from building APIs to leading backend work on an AI platform.' },
  { when: 'Jan 2025 to Jul 2026', place: 'Leicester', org: 'University of Leicester', roles: ['MSc Advanced Computer Science'], note: 'A Master\'s, alongside part-time work and evenings building with my old team.' },
  { when: 'Jun 2025 to Sep 2025', place: 'Remote, UK', org: 'Visiminds Technologies', roles: ['Software Engineer'], note: 'A short contract during my Master\'s, building a security testing platform.' },
  { when: 'Jul 2026 to now', place: 'London', org: 'Goodspeed Studio', roles: ['AI Engineer'], note: 'Building AI agents.' },
];
---
<Base
  title="Sumith Bhandari | A walk from a small town to London"
  description="Sumith Bhandari builds software in London. A short walk through how a kid from a small town got here, and the things he builds now."
>
  <a class="skip" href="#story">Skip to the story</a>

  <header class="top gut">
    <a class="name" href="#top">Sumith Bhandari</a>
    <nav aria-label="Main">
      <ul>
        <li><a href="#story">Story</a></li>
        <li><a href="#journey">Journey</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
        {hasCv && <li><a href={cvHref} download>CV</a></li>}
      </ul>
    </nav>
  </header>

  <main id="main">
    <section class="walk" id="top" aria-label="My story, in six chapters">
      <div class="stage">
        <canvas id="walk-canvas" aria-hidden="true"></canvas>
        <div class="dawn" aria-hidden="true"></div>

        <div class="title gut">
          <p class="kicker">Sumith Bhandari · London</p>
          <h1>A kid from a small town who kept building.</h1>
          <p class="lede">This is how I got here. Scroll, and walk it with me.</p>
          <p class="hint" aria-hidden="true"><span></span>Scroll to walk</p>
        </div>

        <ol class="chapters gut" id="story">
          {chapters.map((c, i) => (
            <li class="chapter" data-ch={i} style={`--i:${i}`}>
              <article aria-labelledby={`ch-${i}`}>
                <p class="meta"><span>{String(i + 1).padStart(2, '0')}</span>{c.yr} · {c.place}</p>
                <h2 id={`ch-${i}`}>{c.title}</h2>
                {c.p.map((t) => <p>{t}</p>)}
              </article>
            </li>
          ))}
        </ol>

        <div class="hud gut" hidden>
          <div class="bar" aria-hidden="true"><i id="walk-progress"></i></div>
          <nav class="map" aria-label="Chapters">
            {chapters.map((c, i) => (
              <button type="button" data-ch={i}><b>{String(i + 1).padStart(2, '0')}</b><span>{c.place}</span></button>
            ))}
          </nav>
          <button type="button" class="sound" aria-pressed="false"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 8h3l4-3v10l-4-3H3z" /><path class="w" d="M13 7.5a3.5 3.5 0 0 1 0 5M15 5a7 7 0 0 1 0 10" /></svg><span>Sound off</span></button>
        </div>
      </div>
    </section>

    <section class="journey gut" id="journey" aria-labelledby="journey-title">
      <div class="head">
        <p class="kicker">The places along the way</p>
        <h2 id="journey-title">Journey</h2>
      </div>
      <ol class="stops">
        {journey.map((j) => (
          <li data-reveal>
            <p class="when">{j.when}<span>{j.place}</span></p>
            <div>
              <h3>{j.org}</h3>
              <p class="roles">{j.roles.join(' · ')}</p>
              <p>{j.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="projects gut" id="projects" aria-labelledby="projects-title">
      <div class="head">
        <p class="kicker">Things I built because I needed them</p>
        <h2 id="projects-title">Projects</h2>
      </div>

      <article class="project feature" aria-labelledby="p-anchor" data-reveal>
        <div class="media">
          <video class="autoplay" muted loop playsinline controls preload="none" width="1280" height="720" poster={m('tour.jpg')}
            aria-label="Claude Anchor menu showing several Claude accounts, folder rules and usage limits.">
            <source src={m('tour-silent.webm')} type="video/webm" />
            <source src={m('tour-silent.mp4')} type="video/mp4" />
          </video>
        </div>
        <div class="txt">
          <h3 id="p-anchor">Claude Anchor</h3>
          <p>I use different Claude accounts for different kinds of work, and kept ending up in the wrong one. So I built a small desktop app: pin a folder to an account once, and Claude Code uses the right one in your terminal and editor from then on.</p>
          <p class="links">
            <a href="https://github.com/SumithSB/claude-anchor">Code on GitHub</a>
            <a href="https://x.com/SumithSBhandari/status/2110735490886365441">Launch post</a>
            <a href="https://github.com/SumithSB/claude-anchor/blob/main/docs/tour.mp4">Tour with sound</a>
          </p>
        </div>
      </article>

      <div class="grid">
        <article class="project" aria-labelledby="p-brainvault" data-reveal>
          <img class="logo" src={m('brainvault-logo.svg')} width="56" height="56" alt="" loading="lazy" />
          <h3 id="p-brainvault">Brainvault</h3>
          <p>Coding agents forget everything between sessions, and I was tired of explaining the same things again. Brainvault gives them a memory that lives on your own machine.</p>
          <p class="links">
            <a href="https://github.com/SumithSB/brainvault">Code on GitHub</a>
            <a href="https://pypi.org/project/brainvault/">On PyPI</a>
          </p>
        </article>
        <article class="project" aria-labelledby="p-fashion" data-reveal>
          <svg class="logo" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27" /><path d="M20 18l8 6 8-6 6 6-5 4v14H19V28l-5-4z" /></svg>
          <h3 id="p-fashion">Fashion AI</h3>
          <p>My Master's project. A styling app that starts from you: your skin tone, your build, where you're going. It suggests what to wear and can talk you through why.</p>
        </article>
        <article class="project next" data-reveal>
          <h3>More coming</h3>
          <p>I'm always building something. The next one will show up here.</p>
          <p class="links"><a href={links.github}>See what I'm working on</a></p>
        </article>
      </div>
    </section>

    <section class="contact gut" id="contact" aria-labelledby="contact-title">
      <p class="kicker">Thanks for walking with me</p>
      <h2 id="contact-title">Say hello.</h2>
      <p>If something here made you curious, or you have a problem worth building for, I'd like to hear about it.</p>
      <p><a class="mail" href={`mailto:${email}`}>{email}</a></p>
      <ul class="social">
        <li><a href={links.github}>GitHub</a></li>
        <li><a href={links.linkedin}>LinkedIn</a></li>
        <li><a href={links.x}>X</a></li>
        {hasCv && <li><a href={cvHref} download>CV</a></li>}
      </ul>
    </section>
  </main>

  <footer class="foot gut">
    <p>© {year} Sumith Bhandari. The town, the city and the kid are all drawn in code.</p>
  </footer>
</Base>

<script>
  import './../scripts/site';
</script>
