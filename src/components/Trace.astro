---
interface Props {
  name: string;
  hops: string[];
}

const { name, hops } = Astro.props;
const W = 640;
const n = hops.length;
const bw = n > 4 ? 112 : 128;
const bh = 56;
const pts = hops.map((_, k) => [70 + k * ((W - 140) / (n - 1)), k % 2 ? 210 : 90]);
let d = `M${pts[0][0]} ${pts[0][1]}`;
for (let k = 1; k < n; k++) {
  const mx = (pts[k - 1][0] + pts[k][0]) / 2;
  d += ` H${mx} V${pts[k][1]} H${pts[k][0]}`;
}
const label = `Simplified drawing of ${name}: ${hops.join(', then ')}.`;
---
<div class="panel trace" data-trace data-hops={JSON.stringify(hops)}>
  <div class="draw">
    <svg viewBox="0 0 640 300" role="img" aria-label={label}>
      <path class="w" d={d} />
      {pts.map((p, k) => (
        <g class="nd" data-x={p[0]} data-y={p[1]}>
          <rect x={p[0] - bw / 2} y={p[1] - bh / 2} width={bw} height={bh} />
          <text x={p[0]} y={p[1]}>{hops[k]}</text>
        </g>
      ))}
      <rect class="pk" width="22" height="22" x="-11" y="-11" opacity="0" />
    </svg>
  </div>
  <div class="ctl">
    <button type="button" class="btn ink" data-send hidden>Send a request through it</button>
    <span class="status" aria-live="polite"></span>
  </div>
</div>
