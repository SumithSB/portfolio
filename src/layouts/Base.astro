---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = '/', noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://sumithsb.github.io/portfolio';
const canonical = site + (path === '/' ? '/' : path);
const ogTitle = 'Sumith Bhandari, AI Software Engineer';
const ogDescription = 'I build AI agents that run in production, and the backends behind them. Projects include Claude Anchor and Brainvault.';
const ogImage = site + '/og-image.png';
const ogAlt = 'Sumith Bhandari, AI Software Engineer in London.';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sumith Sadanand Bhandari',
  jobTitle: 'AI Software Engineer',
  address: { '@type': 'PostalAddress', addressLocality: 'London', addressCountry: 'UK' },
  url: site + '/',
  email: 'mailto:sumithsbhandari@gmail.com',
  sameAs: [
    'https://github.com/SumithSB',
    'https://linkedin.com/in/sumith-sadanand-bhandari',
    'https://x.com/SumithSBhandari',
  ],
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1F2930" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sumith Bhandari" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="preload" href={`${base}/fonts/public-sans.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/big-shoulders-800.woff2`} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Intro and motion only run with JavaScript and without a reduced-motion preference.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { d.classList.add('rm'); }
        else {
          d.classList.add('intro');
          setTimeout(function () { d.classList.remove('intro'); }, 4000);
        }
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <slot />
  </body>
</html>
